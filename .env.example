# LifeOS secrets — copy to `.env` and fill in. `.env` is gitignored; never commit it.
# Nothing here is needed for Stage 1; keys become required as their stage lands.

# --- Stage 3: Google Calendar (read-only ICS) ---------------------------------
# Google Calendar → Settings → <calendar> → "Integrate calendar" →
# "Secret address in iCal format". Treat these URLs as passwords.
ICS_URL_CLASS=
ICS_URL_ACADEMIC=
ICS_URL_PERSONAL=
ICS_URL_PROFESSIONAL=

# --- Stage 5: briefs + capture relay ------------------------------------------
ANTHROPIC_API_KEY=
NOTION_TOKEN=
NOTION_CAPTURE_DB_ID=
